# Copie para .env.local e preencha. O .env.local é gitignored.
# Nenhuma destas tem prefixo NEXT_PUBLIC_ de propósito: as duas são segredos
# de servidor e não podem acabar no bundle do navegador.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=

# Supabase → Project Settings → API Keys → service_role (secret)
# Ignora RLS. Nunca exponha no cliente, em log ou em print.
SUPABASE_SERVICE_ROLE_KEY=

# Resend → API Keys. Permissão de envio basta.
RESEND_API_KEY=

# Remetente dos dois e-mails. O domínio PRECISA estar verificado no Resend,
# senão a API responde 403. Aceita 'contato@beyondthelab.com.br' ou a forma
# com nome: 'Beyond The Lab <contato@beyondthelab.com.br>'.
EMAIL_REMETENTE=

# Caixa da Giovanna. Acumula TRÊS papéis: recebe a notificação de inscrição
# nova, é o reply_to do e-mail de confirmação (para que responder caia no
# Gmail dela), e — desde o corte 3 — é a ALLOWLIST do painel: só este
# e-mail entra em /admin.
#
# ⚠️ Um endereço só. Ver o aviso na seção do painel, mais abaixo.
EMAIL_ADMIN=

# Base absoluta de OG/Twitter. Opcional — ver README.
NEXT_PUBLIC_SITE_URL=

# ------------------------------------------------------------
# Painel (corte 3)
# ------------------------------------------------------------
# Supabase → Project Settings → API Keys → anon / public.
#
# ⚠️ ELA NÃO GANHA PREFIXO `NEXT_PUBLIC_`, apesar de a chave `anon` ser
# desenhada para ser pública. Não é contradição — é que o navegador NUNCA
# fala com o Supabase neste projeto: o fluxo de OAuth inteiro é iniciado e
# concluído por rotas nossas, do lado do servidor. Uma variável que ninguém
# no cliente usa não tem por que ser embutida no bundle, e o prefixo
# ausente mantém a regra do repositório sem exceção para alguém interpretar
# depois.
#
# ⚠️ Ela NÃO substitui a `service_role` e não faz o trabalho dela: com RLS
# ligada e ZERO policies em todas as tabelas, esta chave não lê uma única
# linha de dado pessoal. Ela só resolve "quem é você?".
SUPABASE_ANON_KEY=

# ⚠️ NÃO EXISTE `ADMIN_EMAILS`. Quem autoriza o painel é a `EMAIL_ADMIN`
# lá em cima — ela acumula TRÊS papéis: destinatário da notificação,
# reply_to da confirmação, e quem pode entrar em /admin.
#
# ⚠️ VAZIA OU AUSENTE = NINGUÉM ENTRA, e isso é desenho (D-09). O erro
# natural seria "se não estiver configurada, deixa passar" — essa linha é a
# que abre o painel para a internet no dia em que alguém esquecer a
# variável num deploy, e o sintoma é ZERO: nada quebra, nada avisa.
#
# ⚠️ NÃO ACRESCENTE VÍRGULA ALI para criar um segundo admin: a mesma
# variável é o endereço de destino dos e-mails, e uma lista quebraria o
# envio em silêncio. O dia do segundo admin é o dia de separar as duas —
# o raciocínio completo está em src/lib/admin.ts.

# ------------------------------------------------------------
# ⚠️ O QUE PRECISA SER CONFIGURADO FORA DO CÓDIGO, para o login funcionar
# ------------------------------------------------------------
# 1. Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client ID
#    (tipo "Web application"). O "Authorized redirect URI" é o do SUPABASE,
#    não o nosso: https://<projeto>.supabase.co/auth/v1/callback
# 2. Supabase → Authentication → Providers → Google: ligar, e colar o
#    Client ID e o Client Secret do passo 1.
# 3. Supabase → Authentication → URL Configuration → Redirect URLs:
#    acrescentar http://localhost:3000/admin/callback e a URL de produção.
#    ⚠️ Sem este passo o login termina EM SILÊNCIO na página errada — o
#    Supabase redireciona para o Site URL do projeto e não há erro visível
#    em lugar nenhum.

# ------------------------------------------------------------
# Stripe (corte 2)
# ------------------------------------------------------------
# ⚠️ MODO TESTE E MODO LIVE SÃO DOIS UNIVERSOS SEPARADOS. Produtos,
# preços, clientes, assinaturas, cupons e webhooks de um NÃO existem no
# outro. Em desenvolvimento, use sempre `sk_test_` — com `sk_live_` cada
# rodada de teste cria assinatura real, com cartão salvo e cobrança
# agendada, e desfazer isso é reembolso de assinatura, o pior fluxo de
# suporte que existe (ver D-04).
#
# Dashboard → liga o toggle "Test mode" → Developers → API keys → Secret key
STRIPE_SECRET_KEY=

# Segredo de assinatura do webhook. É o que prova que o POST veio do
# Stripe: sem ele a rota é um endpoint público onde qualquer um declara
# "esta assinatura foi paga".
#
# ⚠️ NÃO É O MESMO VALOR EM DESENVOLVIMENTO E EM PRODUÇÃO.
#   local:     `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#              imprime um `whsec_` NOVO a cada execução — ele é do túnel.
#   deployado: Dashboard (Test mode) → Developers → Webhooks → cria o
#              endpoint → o `whsec_` de lá é estável.
STRIPE_WEBHOOK_SECRET=

# Não há chave publicável, e a ausência é desenho: o Checkout é hospedado
# pelo Stripe, nenhum campo de cartão é renderizado por nós e nenhum
# Stripe.js é carregado. Ver o cabeçalho de src/lib/stripe.ts.
