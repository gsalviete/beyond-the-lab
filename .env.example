# Copie para .env.local e preencha. O .env.local é gitignored.
# Nenhuma destas tem prefixo NEXT_PUBLIC_ de propósito: as duas são segredos
# de servidor e não podem acabar no bundle do navegador.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=

# Supabase → Project Settings → API Keys → service_role (secret)
# Ignora RLS. Nunca exponha no cliente, em log ou em print.
SUPABASE_SERVICE_ROLE_KEY=

# Resend → API Keys. Permissão de envio basta.
RESEND_API_KEY=

# Remetente dos dois e-mails. O domínio PRECISA estar verificado no Resend,
# senão a API responde 403. Aceita 'contato@beyondthelab.com.br' ou a forma
# com nome: 'Beyond The Lab <contato@beyondthelab.com.br>'.
EMAIL_REMETENTE=

# Caixa da Giovanna. Acumula dois papéis: recebe a notificação de inscrição
# nova e é o reply_to do e-mail de confirmação, para que responder caia no
# Gmail dela.
EMAIL_ADMIN=

# Base absoluta de OG/Twitter. Opcional — ver README.
NEXT_PUBLIC_SITE_URL=

# ------------------------------------------------------------
# Stripe (corte 2)
# ------------------------------------------------------------
# ⚠️ MODO TESTE E MODO LIVE SÃO DOIS UNIVERSOS SEPARADOS. Produtos,
# preços, clientes, assinaturas, cupons e webhooks de um NÃO existem no
# outro. Em desenvolvimento, use sempre `sk_test_` — com `sk_live_` cada
# rodada de teste cria assinatura real, com cartão salvo e cobrança
# agendada, e desfazer isso é reembolso de assinatura, o pior fluxo de
# suporte que existe (ver D-04).
#
# Dashboard → liga o toggle "Test mode" → Developers → API keys → Secret key
STRIPE_SECRET_KEY=

# Segredo de assinatura do webhook. É o que prova que o POST veio do
# Stripe: sem ele a rota é um endpoint público onde qualquer um declara
# "esta assinatura foi paga".
#
# ⚠️ NÃO É O MESMO VALOR EM DESENVOLVIMENTO E EM PRODUÇÃO.
#   local:     `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#              imprime um `whsec_` NOVO a cada execução — ele é do túnel.
#   deployado: Dashboard (Test mode) → Developers → Webhooks → cria o
#              endpoint → o `whsec_` de lá é estável.
STRIPE_WEBHOOK_SECRET=

# Não há chave publicável, e a ausência é desenho: o Checkout é hospedado
# pelo Stripe, nenhum campo de cartão é renderizado por nós e nenhum
# Stripe.js é carregado. Ver o cabeçalho de src/lib/stripe.ts.
