# Copie para .env.local e preencha. O .env.local é gitignored.
# Nenhuma destas tem prefixo NEXT_PUBLIC_ de propósito: as duas são segredos
# de servidor e não podem acabar no bundle do navegador.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=

# Supabase → Project Settings → API Keys → service_role (secret)
# Ignora RLS. Nunca exponha no cliente, em log ou em print.
SUPABASE_SERVICE_ROLE_KEY=

# Base absoluta de OG/Twitter. Opcional — ver README.
NEXT_PUBLIC_SITE_URL=
